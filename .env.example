# Valores para rodar no host (`yarn dev`). No compose do vcnafacul-stack
# (tickets/055), MONGODB e PORT são sobrescritos pelo próprio compose.
NODE_ENV=development
# Mongo com replica set (transações). Local: docker-mongodb-replica.sh ou o
# compose do stack. Homol: mesmo cluster do ms-simulado, banco /form.
MONGODB=mongodb://localhost:27017/form?replicaSet=rs0
# 3334: a api procura o form aqui (FORMULARIO_URL) e não colide com o ms-simulado (3000).
PORT=3334
# Tem de ser IGUAL ao ADMIN_FORM_SECRET da api (diferente = 401 em /admin-form/*).
ADMIN_FORM_SECRET=troque-me
